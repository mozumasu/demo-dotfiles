{
  "playwright": {
    "command": "playwright-mcp",
    "args": [
      "--extension",
      "--executable-path",
      "${CLAUDE_PLUGIN_ROOT}/bin/ardia-open",
      "--output-dir",
      "${HOME}/.cache/playwright-mcp"
    ],
    "env": {
      "PLAYWRIGHT_MCP_USER_DATA_DIR": "${HOME}/Library/Application Support/com.ardia.browser/Chromium"
    }
  }
}
