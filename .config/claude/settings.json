{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "theme": "dark",
  "language": "ja",
  "outputStyle": "Concise",
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/dotfiles/.config/claude/plugins/slidev-preview"
  },
  "extraKnownMarketplaces": {
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    }
  },
  "enabledPlugins": {
    "eli5@claude-community": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/japanese-guard"
          }
        ]
      }
    ]
  }
}
